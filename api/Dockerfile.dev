
FROM gradle:8.5-jdk21 AS builder

WORKDIR /app

COPY gradle gradle
COPY --chmod=0750 gradlew ./
COPY build.gradle settings.gradle ./
COPY jacoco.gradle ./


RUN chmod +x gradlew

RUN ./gradlew dependencies --no-daemon

COPY . .

EXPOSE 8080

CMD ["./gradlew", "bootRun",--no-daemon, "--continuous", "-Dspring-boot.run.profiles=dev", "-Dspring.devtools.restart.enabled=true", "-Dspring.devtools.livereload.enabled=true", "-Dspring.devtools.remote.secret=mysecret"]
